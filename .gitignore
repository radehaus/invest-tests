# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Echte Allianz-Daten: nie im Klartext ins öffentliche Repo (Anforderungen Abschnitt 7)
/data/private/
